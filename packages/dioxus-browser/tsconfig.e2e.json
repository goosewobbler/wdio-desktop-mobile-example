{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules", "./node_modules/@types"],
    "types": ["node", "@wdio/globals/types", "webdriverio", "mocha", "@wdio/native-types"]
  },
  "include": ["test/**/*.ts", "wdio*.conf.ts", "test/**/*.d.ts"]
}
